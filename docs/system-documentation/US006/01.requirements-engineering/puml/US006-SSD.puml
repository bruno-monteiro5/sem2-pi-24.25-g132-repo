@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

    Player -> System : asks to upgrade a station
    activate System

        System --> Player : shows map list and asks to select one
    deactivate System

        Player -> System : selects map
        activate System

        System --> Player : requests to select scenario
    deactivate System

        Player -> System : selects scenario
        activate System

        System --> Player : shows station list
    deactivate System

    Player -> System : selects a station
    activate System

loop while player wants to upgrade
        System --> Player : requests upgrade type
    deactivate System

    Player -> System : selects upgrade type
    activate System

end loop
        System --> Player : shows all new station data\n and requests confirmation
    deactivate System

    Player -> System : confirms data
    activate System

        System --> Player : displays operation success
    deactivate System
@enduml