@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class ApplicationSession
{
    - ApplicationSession()
    + {static} getInstance()
    + getCurrentSession()
}

class UserSession
{
    + getUserEmail()
}

class Company {
    - designation : String

    + getNetworkByManagerEmail(email)
}

class Manager {
    - name : String
    - email : String

    + Manager(name, email)
    + getName()
    + getEmail()
}

class Building {
    - type : String
    - year : int

    + Building(type, year)
    + getType()
    + getYear()
}

class Station {
    - name : String
    - location : String
    - openingDate : LocalDate
    - buildings : List<Building>

    + Station(name, location, openingDate)
    + addBuilding(building)
    + getBuildings()
    + hasBuilding(buildingType)
    - validateBuilding(building)
}

class RailwayNetwork {
    - name : String
    - stations : List<Station>
    - manager : Manager

    + RailwayNetwork(name, manager)
    + addStation(station)
    + getStationByName(stationName)
    + getStations()
    + getNetworkManager()
    + upgradeStation(stationName, buildingType, year)
}

class BuildingTypeRepository {
    + getBuildingTypes()
    + getBuildingTypeByName(typeName)
}

class NetworkRepository {
    + getNetworks()
    + get
}


@enduml