@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {

}

class Station {
    name
    type
    coordinates
}

class RailwayLine {
    length
    isElectrified
}

class MaintenanceRoute {
    startStation
    routeSequence
}

Player "1" -- "1" MaintenanceRoute : requests

Station "1" - "*" RailwayLine : connected to
RailwayLine "*" - "2" Station :connects

MaintenanceRoute "*" - "*" RailwayLine : uses

@enduml
