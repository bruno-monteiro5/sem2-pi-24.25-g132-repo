@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "Game System" as System

activate Player

    Player -> System : Requests verification of maintenance route
    activate System

        System --> Player : Gives the choice between all lines or only electrified lines
    deactivate System

    Player -> System : Selects one of the available options
    activate System

        alt valid maintenance route exists
            System --> Player : Returns the route starting from a valid station and passes only once through each railway line
        else invalid or no route from selected station
            System --> Player : Displays error: selected station cannot serve as the starting point of the maintenance route
        end

    deactivate System

@enduml
