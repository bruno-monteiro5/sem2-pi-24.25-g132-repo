@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class BuildStationUI {
    + run()
}

class BuildStationController {
    + BuildStationController()
    + getPlayer()
    + getStationTypes(): List<StationType>
    + buildStation(stationDetails)
    - getPlayerFromSession(): Player
}

class ApplicationSession {
    - ApplicationSession()
    + getInstance(): ApplicationSession
    + getCurrentSession(): UserSession
}

class UserSession {
    + getCurrentUser(): Player
}

class Player {
    - username: String
    + buildStation(stationDetails)
    + instantiateStation(stationDetails): Station
    + validateStationLocally(station): boolean
}

class Station {
    - type: String
    - location : positon
    - name: String
}

class StationRepository {
    + validateStationGlobally(station): boolean
    + save(station): void
}

class Repositories {
    - Repositories()
    + getInstance(): Repositories
    + getStationRepository(): StationRepository
    + getStationTypeRepository(): StationTypeRepository
}

class StationTypeRepository {
    + getAllStationTypes(): List<StationType>
}

class StationType {
    - name: String
    - cost : int
    - radius : int
}

BuildStationUI .> BuildStationController
BuildStationController ..> ApplicationSession
BuildStationController ..> UserSession
ApplicationSession ..> UserSession
BuildStationController --> Player
BuildStationController --> Repositories
Repositories --> StationRepository
Repositories --> StationTypeRepository
Repositories -> "1" Repositories : instance
ApplicationSession -> "1" ApplicationSession : instance
BuildStationController --> StationRepository
BuildStationController --> StationTypeRepository
Player --> "*" Station : stations
StationRepository --> Station : stations
StationTypeRepository --> "*" StationType : stationTypes
@enduml