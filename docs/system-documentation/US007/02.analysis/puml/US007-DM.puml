@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
    username
    password
    +listStations()
}

class Station {
    name
    type
    positionX
    positionY
}

class StationBuildings {
    type

}

class CargosInDemand {
    type
    quantity
}
class CargosInSupply {
    type
    quantity
}

class ListStations {
    Station
}

Player --> ListStations : requests to >
ListStations "1" -- "*" Station : has >
Station "1" -- "*" StationBuildings : has
Station "1" -- "*" CargosInDemand : has
Station "1" -- "*" CargosInSupply : has
@enduml