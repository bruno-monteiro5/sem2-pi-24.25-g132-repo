@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class Player {
    - name : String
    - balance : double
    + Player(name : String, initialBalance : double)
    + getName() : String
    + getBalance() : double
    + selectStation(stations : List<StationDetails>) : StationDetails
}

class StationDetailsUI {
    + run()
}

class StationDetailsController {
    - stationDetailsRepository : StationDetailsRepository
    + StationDetailsController()
    + listStationDetails() : List<StationDetails>
}

class StationDetails {
    - stationName : String
    - position : Position
    - stationType : StationType
    - supplyCargo : List<Cargo>
    - demandCargo : List<Cargo>
    - buildings : List<Building>
    + StationDetails(stationName : String, position : Position, stationType : StationType)
    + getStationName() : String
    + getSupplyCargo() : List<Cargo>
    + getDemandCargo() : List<Cargo>
    + getBuildings() : List<Building>
}

class StationDetailsRepository {
    - stationDetailsList : List<StationDetails>
    + getInstance() : StationDetailsRepository
    + addStationDetails(details : StationDetails)
    + getAllStationDetails() : List<StationDetails>
    + getStationDetailsByName(name : String) : StationDetails
}

class Cargo {
    - type : CargoType
    - quantity : int
    - isAvailable : boolean
    + Cargo(type : CargoType, quantity : int, isAvailable : boolean)
    + getType() : CargoType
    + getQuantity() : int
    + isAvailable() : boolean
}

class Building {
    - type : BuildingType
    + Building(type : BuildingType)
    + getType() : BuildingType
}

class Position {
    - x : int
    - y : int
    + Position(x : int, y : int)
    + getX() : int
    + getY() : int
}

enum CargoType {
    <<enumeration>>
    PASSENGERS
    MAIL
    FOOD
    COAL
    STEEL
    CARS
    TEXTILES
    IRON_ORE
    OTHER

    + toString() : String
}

enum BuildingType {
    <<enumeration>>
    TELEGRAPH : { cost: 100, replaces: null, availableYear: 1850 }
    TELEPHONE : { cost: 200, replaces: TELEGRAPH, availableYear: 1900 }
    CAFE_SMALL : { cost: 150, replaces: null, availableYear: 1850 }
    CAFE_LARGE : { cost: 300, replaces: CAFE_SMALL, availableYear: 1900 }
    POST_OFFICE : { cost: 250, replaces: null, availableYear: 1850 }

    - cost : double
    - replaces : BuildingType
    - availableYear : int

    + getCost() : double
    + getReplaces() : BuildingType
    + isAvailableIn(year : int) : boolean
    + getBuildingTypeDetails() : BuildingType
}

enum StationType {
    <<enumeration>>
    DEPOT : { cost : double = 50000, radius : int = 3 }
    STATION : { cost : double = 100000, radius : int = 4 }
    TERMINAL : { cost : double = 200000, radius : int = 5 }
}

Player --> StationDetailsUI : selectStation()
StationDetailsUI --> StationDetailsController : listStationDetails()
StationDetailsController --> StationDetailsRepository : getAllStationDetails()
StationDetails --> Position
StationDetails --> StationType
StationDetails --> Cargo
StationDetails --> Building
Cargo --> CargoType
Building --> BuildingType

@enduml