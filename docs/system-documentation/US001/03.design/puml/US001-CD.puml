@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class ApplicationSession {
    - ApplicationSession()
    + {static} getInstance()
    + getCurrentSession()
}

class UserSession {
    + getCurrentUser()
}

class Map {
    - name : String
    - width : Integer
    - height : Integer
    + Map(name, width, height)
    + isValidName() : boolean
    + isValidSize() : boolean
}

class Editor {
    - email : String
    + createMap(mapDetails)
    + instantiateMap(mapDetails)
    + validateMapLocally(map)
}

class MapRepository {
    + validateMapGlobally(map)
    + save(map)
}

class Repositories {
    - Repositories()
    + {static} getInstance()
    + getMapRepository()
}

class CreateMapController {
    + CreateMapController()
    + getEditor()
    + createMap(mapDetails)
    - getEditorFromSession()
}

class CreateMapUI {
}

CreateMapUI .> CreateMapController
CreateMapController ..> ApplicationSession
CreateMapController ..> UserSession
CreateMapController ..> Map
CreateMapController ..> Editor
CreateMapController ..> MapRepository
CreateMapController .> Repositories
Repositories -> "1" Repositories : instance
Repositories --> "1" MapRepository : mapRepository
ApplicationSession -> "1" ApplicationSession : instance
ApplicationSession ..> UserSession
MapRepository --> "*" Map : maps
Editor --> "*" Map : maps

@enduml

