@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":CreateMapUI" as UI
participant ":CreateMapController" as CTRL
participant ":Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as REPO
participant "mapRepository:\nMapRepository" as mapRepository
participant "Map:\nMap" as Map

activate Editor

    Editor -> UI : requests to create a new map

    activate UI

        ' create controller
        UI -> CTRL** : create

        UI -> Editor : request map name and size
        Editor -> UI : provides map details

        UI -> CTRL : createMap(mapDetails)

        activate CTRL
        ref over CTRL
            Create a map
        end ref

        CTRL --> UI : confirmation
        deactivate CTRL

    UI --> Editor : show result (success/failure)

deactivate UI
deactivate Editor

@enduml
