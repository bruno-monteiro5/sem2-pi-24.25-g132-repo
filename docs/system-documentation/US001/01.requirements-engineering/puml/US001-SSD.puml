@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":System" as System

activate Editor

    Editor -> System : asks to create a new map
    activate System

        System --> Editor : asks for map name
    deactivate System

    Editor -> System : inputs name
    activate System
        System --> Editor : validates name
        System --> Editor : asks for map width
    deactivate System

    Editor -> System : inputs map width
    activate System
        System --> Editor : validates width
        System --> Editor : asks for map height
    deactivate System

    Editor -> System : inputs map height
    activate System
        System --> Editor : validates height
        System --> Editor : displays map data
        System --> Editor : asks for confirmation (Y-yes/N-no)
    deactivate System

    Editor -> System : confirms creation (Y/N)
    activate System

    alt User confirms (Y)
        System --> Editor : creates map and displays operation success
    else User cancels (N)
        System --> Editor : displays cancellation message
    end

    deactivate System
@enduml
