@startuml
actor Editor
participant ":CreateCityUI" as UI
participant ":CreateCityController" as CTRL
participant "Repositories" as REPOS
participant "cityRepository\n:CityRepository" as CITY_REPO
participant "mapRepository\n:MapRepository" as MAP_REPO
participant "City" as CITY

Editor -> UI : requests to add city
activate UI
    UI -> CTRL : createCity(map, name, position, houseBlocks)
    activate CTRL
        CTRL -> REPOS : getInstance()
        activate REPOS
            REPOS --> CTRL : repositories
        deactivate REPOS

        CTRL -> REPOS : getCityRepository()
        activate REPOS
            REPOS --> CTRL : cityRepository
        deactivate REPOS

        CTRL -> REPOS : getMapRepository()
        activate REPOS
            REPOS --> CTRL : mapRepository
        deactivate REPOS

        CTRL -> CITY_REPO : cityExists(name)
        activate CITY_REPO
            CITY_REPO --> CTRL : true/false
        deactivate CITY_REPO

        CTRL -> CITY_REPO : positionInvalid(position)
        activate CITY_REPO
            CITY_REPO --> CTRL : true/false
        deactivate CITY_REPO

        alt houseBlocks == -1
            CTRL -> CITY : new City(map, name, position, 1)
            activate CITY
                CITY -> CITY : generateRandomHouseBlocks()
                CITY --> CTRL : city
            deactivate CITY
        else
            CTRL -> CITY : new City(map, name, position, houseBlocks)
            activate CITY
                CITY --> CTRL : city
            deactivate CITY
        end

        CTRL -> CITY_REPO : save(city)
        activate CITY_REPO
            CITY_REPO --> CTRL : void
        deactivate CITY_REPO

        CTRL --> UI : success/error
    deactivate CTRL
UI --> Editor : shows result
deactivate UI
@enduml