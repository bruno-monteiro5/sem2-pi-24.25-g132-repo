@startuml
' Main classes
class City {
    - map : Map
    - name : String
    - position : Position
    - houseBlocks : int
    - houseBlocksList : List<HouseBlock>
    + City(map, name, position, houseBlocks)
    + getMap() : Map
    + getName() : String
    + getPosition() : Position
    + getX() : int
    + getY() : int
    + getNumberOfHouseBlocks() : int
    + getHouseBlocksList() : List<HouseBlock>
    + setMap(map : Map)
    + setName(name : String)
    + setPositionX(x : int)
    + setPositionY(y : int)
    + setNumberOfHouseBlocks(n : int)
    + generateRandomHouseBlocks()
    + toString() : String
}

class HouseBlock {
    - position : Position
    + HouseBlock(position : Position)
    + getPosition() : Position
    + setPosition(position : Position)
    + toString() : String
}

class Position {
    - x : int
    - y : int
    + getX() : int
    + getY() : int
    + setX(x : int)
    + setY(y : int)
}

class Map {
    - name : String
    - width : int
    - height : int
    - editor : String
    + getWidth() : int
    + getHeight() : int
}

class CityRepository {
    - cities : List<City>
    + getCities() : List<City>
    + cityExists(name : String) : boolean
    + save(city : City)
    + positionInvalid(position : Position) : boolean
}

' Relationships
City "1" -- "1" Map : belongs to
City "1" -- "1" Position : has
City "1" -- "*" HouseBlock : contains
HouseBlock "1" -- "1" Position : has
CityRepository "1" -- "*" City : manages

@enduml