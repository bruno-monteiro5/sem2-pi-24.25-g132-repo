@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":System" as System

activate Editor

    Editor -> System : asks to create a city
    activate System

        System --> Editor : shows list of maps
        System --> Editor : asks to select one
    deactivate System

    Editor -> System : selects map
    activate System

        System --> Editor : asks for city name
    deactivate System

    Editor -> System : inputs name
    activate System

        System --> Editor : validates name (format and duplication)
    deactivate System

    Editor -> System : inputs x coordinate
    activate System
        System --> Editor : validates x (within map bounds)
    deactivate System

    Editor -> System : inputs y coordinate
    activate System
        System --> Editor : validates y (within map bounds)
    deactivate System

    Editor -> System : inputs number of house blocks
    activate System
        System --> Editor : validates positive integer
         System --> Editor : asks if house blocks should be added manually (Y-yes/N-no)
    deactivate System


    Editor -> System : confirms manual house block placement? (Y/N)
    activate System
    deactivate System

    alt Manual house block placement

        loop For each house block
            Editor -> System : inputs x and y of house block
            activate System
                System --> Editor : validates block position
            deactivate System
        end

    else Automatic house block placement
        System --> Editor : generates positions automatically
    end

    System --> Editor : displays city data
    System --> Editor : asks for confirmation (Y-yes/N-no)

    Editor -> System : confirms (Y) or cancels (N)
    activate System

    alt User confirms (Y)
        System --> Editor : adds city and displays operation success
    else User cancels (N)
        System --> Editor : displays cancellation message
    end

    deactivate System

@enduml
