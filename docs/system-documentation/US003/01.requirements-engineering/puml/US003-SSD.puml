@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":System" as System

activate Employee

    Employee -> System : asks to creat a city
    activate System

        System --> Employee : shows a maps list and asks to select one
    deactivate System

    Employee -> System : selects a map
    activate System

        System --> Employee : requests data (i.e. name, house blocks, XY coordinates)
    deactivate System

    Employee -> System : types requested data
    activate System

        System --> Employee : validates name and position
        System --> Employee : shows all data and requests confirmation
    deactivate System

    Employee -> System : confirms data
    activate System

        System --> Employee : displays operation success
    deactivate System

@enduml