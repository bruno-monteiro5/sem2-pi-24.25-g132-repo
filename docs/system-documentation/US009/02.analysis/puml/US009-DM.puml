@startuml
skinparam monochrome true
hide circle
hide methods

class Player {
}

class Locomotive {
  name
  type
  price
  power
  maintenanceCost
}

class Scenario {
  startYear
  endYear
  allowedTypes
}

class LocomotiveType {
  STEAM
  DIESEL
  ELECTRIC
}

class Train {
  assignedRoute
}

Player "1" --> "*" Locomotive : buys >
Locomotive "1" -- "1" Scenario : restricted by >
Locomotive "1" -- "1" Train : powers >
LocomotiveType <|-- Locomotive

Train "1" -- "*" Route : assigned to >
@enduml