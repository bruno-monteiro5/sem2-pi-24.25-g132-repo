@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class Player {
    + email: String
}

class Locomotive {
    + name: String
    + type: LocomotiveType
    + startYear: int
    + cost: double
}

enum LocomotiveType {
    STEAM
    DIESEL
    ELECTRIC
}

class Scenario {
    + availableLocomotives: List<Locomotive>
    + getAvailableLocomotives(currentYear: int): List<Locomotive>
}

class LocomotiveRepository {
    + getAvailableLocomotives(scenario: Scenario, year: int): List<Locomotive>
}

class BuyLocomotiveController {
    + getAvailableLocomotives(year: int): List<Locomotive>
    + buyLocomotive(loco: Locomotive): void
}

class BuyLocomotiveUI {
    + openInterface()
}

Player --> BuyLocomotiveUI : uses
BuyLocomotiveUI .> BuyLocomotiveController : controls
BuyLocomotiveController --> Scenario : accesses
BuyLocomotiveController --> LocomotiveRepository : fetches
Scenario --> Locomotive : offers
Locomotive --> LocomotiveType : classified as

@enduml