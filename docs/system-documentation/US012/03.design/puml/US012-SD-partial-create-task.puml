@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant "controller\n:CreateSimulatorController" as CTRL
participant "simulator\n:Simulator" as SIM

autonumber 16
-> CTRL : createSimulator(editor, stationList)

autonumber 16.1
activate CTRL
    group Create Simulator

        CTRL --> SIM** : create(editor, stationList)
        CTRL -> SIM : generateCargo()

        activate SIM
            SIM -> SIM : start()
            SIM --> CTRL : simulator
        deactivate SIM

    end

autonumber 17
<-- CTRL : simulator
deactivate CTRL
@enduml