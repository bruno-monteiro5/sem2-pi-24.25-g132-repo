@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as PLAYER

participant ":CreateSimulatorUI" as UI
participant ":CreateSimulatorController" as CTRL
participant "simulator\n:Simulator" as SIMULATOR

activate PLAYER

    PLAYER -> UI : asks to create a new simulator
    activate UI

        UI --> CTRL** : create()
        UI -> CTRL : getAvailableStations()
        ref over CTRL
            Get Station List
        end ref

        activate CTRL
            CTRL --> UI : stationList
        deactivate CTRL

        UI --> PLAYER : shows station list and asks to confirm
    deactivate UI

    PLAYER -> UI : confirms creation
    activate UI

        UI -> CTRL : createSimulator()
        activate CTRL

            CTRL -> CTRL : getEditorFromSession()
            activate CTRL
                ref over CTRL
                    Get Editor
                end ref
                CTRL --> CTRL : editor
            deactivate CTRL

            CTRL -> SIMULATOR : create(editor, stationList)
            activate SIMULATOR
                ref over SIMULATOR
                    Create Simulator
                end
                SIMULATOR --> CTRL : simulator
            deactivate SIMULATOR

            CTRL --> UI : simulator
        deactivate CTRL

        UI --> PLAYER : displays simulation success
    deactivate UI

deactivate PLAYER
@enduml