@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class Player {
    + email: String
}

class Simulator {
    + start()
    + pause()
    + generateCargo()
}

class Station {
    + name: String
    + servedCity: City
    + servedIndustries: List<Industry>
    + storeCargo(cargo: Cargo)
}

class City {
    + name: String
    + population: int
}

class Industry {
    + name: String
    + type: IndustryType
}

enum IndustryType {
    FARM
    MINE
    FACTORY
}

class Cargo {
    + type: CargoType
}

enum CargoType {
    PASSENGERS
    MAIL
    COAL
    STEEL
}

class CreateSimulatorController {
    + createSimulator(): Simulator
}

class CreateSimulatorUI {
    + openInterface()
}

Player --> CreateSimulatorUI : uses
CreateSimulatorUI .> CreateSimulatorController : controls
CreateSimulatorController --> Simulator : creates
Simulator --> Station : generatesFor
Station --> City : serves
Station --> Industry : serves
Station --> Cargo : stores
Industry --> IndustryType : classifiedAs
Cargo --> CargoType : identifiedBy

@enduml