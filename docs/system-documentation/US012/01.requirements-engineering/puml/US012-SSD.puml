@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

    Player -> System : The player asks to start the simulation
    activate System
        System --> Player : The simulation starts running
    deactivate System

    Player -> System : The player asks to pause the simulation
    activate System
        System --> Player : The simulation is paused
    deactivate System

    Player -> System : The player asks to change the speed
    activate System
        System --> Player : The simulation speed is changed
    deactivate System
@enduml