name
positionX
positionY
houseBlocks
}

class Industry {
}

class PrimaryIndustry

class TransformingIndustry

class MixedIndustry

class Player {
id
}

class RailwayLine{
length
cost
}


class Station {
    name

}

class Train {
name
}

class Locomotive {
power
acceleration
topSpeed
yearOfOperation
fuelCost
maintenanceCost
acquisitionPrice
}

class LocomotionType{
name
}

class Route {
name
length
}

class RouteStop {
carriages
}

class Cargo {
type
