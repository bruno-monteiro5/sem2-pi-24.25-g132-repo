@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods
title Domain Model

class Editor {
name
password
}

class Map {
name
dimensionX
dimensionY
 }

class Scenario {
name
configuration
status
}


class City {
name
positionX
positionY
houseBlocks
}

class Industry {
positionX
positionY
}

class PrimaryIndustry {
    resource
    farms
}

class TransformingIndustry {
    initialResource
    finalResource
}

class MixedIndustry {
    importedResource
    exportedResource
}

class Player {
}

class Station {
name
}



Editor "1" -- "0..*" Map : Create >
Editor "1" -- "0..*" Industry : Adds >
Editor "1" -- "0..*" City : Adds >
Editor "1" -- "0..*" Scenario : Creates >

Map "1" -- "*" Industry : Has >
Map "1" -- "*" City : Has >

Industry "1" -- "1" PrimaryIndustry : Consists of
Industry "1" -- "1" TransformingIndustry : Consists of
Industry "1" -- "1" MixedIndustry : Consists of

Player -- Station : Build
@enduml