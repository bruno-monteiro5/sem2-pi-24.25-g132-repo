@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods
title Domain Model

class Editor {
id
}

class Map {
name
dimensionX
dimensionY
 }

class Scenario {
name
timePeriod
status
}

class Simulator {
  currentTime
  isRunning
}

class TechnologicalRestrictions {
availableLocomotives
availableIndustries
}

class HistoricalRestrictions {
event
demand
}

class City {
name
positionX
positionY
houseBlocks
}

class Industry {
positionX
positionY
}

class PrimaryIndustry {
    resource
    farms
}

class TransformingIndustry {
    initialResource
    finalResource
}

class MixedIndustry {
    importedResource
    exportedResource
}

class Player {
id
}

class Station {
    name
    type
    cost
    positionX
    positionY
    centre
    economicRadius
}

class Train {
name
}

class Locomotive {
type
power
acceleration
topSpeed
yearOfOperation
fuelCost
maintenanceCost
acquisitionPrice
}

class Route {
name
length
}

class RouteStop {
carriages
}

class Cargo {
type
quantity
}

class Carriage {
cargoType
}

class Building {
type
cost
}



Editor "1" -- "*" Map : Create >
Editor "1" -- "*" Industry : Adds >
Editor "1" -- "*" City : Adds >
Editor "1" -- "*" Scenario : Creates >

Map "1" -- "*" Industry : Contains >
Map "1" -- "*" City : Contains >

Scenario "1" -- "1" Map : Restricts >
Scenario "1" -- "1" TechnologicalRestrictions : Defines >
Scenario "1" -- "1" HistoricalRestrictions : Defines >

Industry "1" -- "1" PrimaryIndustry : Consists of
Industry "1" -- "1" TransformingIndustry : Consists of
Industry "1" -- "1" MixedIndustry : Consists of
Industry "1" -- "*" Cargo : Demands >
Industry "1" -- "*" Cargo : Supplies >

Player "1" -- "*" Station : Builds >
Player "1" -- "*" Locomotive : Buys >
Player "1" -- "*  "  Building : Upgrades Station With >
Player "1" -- "*" Route : Assigns Train to >
Player "1" -- "1" Simulator : controls >

Simulator "1" -- "1" Scenario : uses >


Train "1" -- "1" Locomotive : Comprises >
Train "1" -- "*" Carriage : Comprises >
Train "1" -- "1" Route : Follows >

Carriage "1" -- "*" Cargo : Carries >

Route "1" -- "1..*" RouteStop : has >
Route "1" -- "1..*" Station : includes >

RouteStop "1" -- "1" Station : Occurs at >
RouteStop "*" -- "*" Cargo : Loads >

Station "1" -- "1" Building : is upgraded with >

@enduml