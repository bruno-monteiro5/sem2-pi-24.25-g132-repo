@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
'skinparam shadowing false


'title Use Case Diagram Example

left to right direction

'rectangle "System Actors" as actors {
    actor "Player" as Player
    actor "Editor" as Editor
    actor "Product\nOwner" as Owner
'}

'rectangle "Use Cases" as usecases{
    usecase "UC1 - Create a map" as UC1
    Editor --> UC1

    usecase "UC2 - Add an industry" as UC2
    Editor --> UC2

    usecase "UC3 - Add a city" as UC3
    Editor --> UC3

    usecase "UC4 - Create a scenario" as UC4
    Editor --> UC4

    usecase "UC5 - Build a station." as UC5
    Player --> UC5

    usecase "UC6 - Upgrade a selected station with a building" as UC6
    Player --> UC6

    usecase "UC7 -  See the details of a station" as UC7
    Player --> UC7

    usecase "UC9 -  Buy a train" as UC9
    Player --> UC9

    usecase "UC10 - Assign a train to a route" as UC10
    Player --> UC10

    usecase "UC12 - Create a simulator" as UC12
    Owner --> UC12


'}


@enduml