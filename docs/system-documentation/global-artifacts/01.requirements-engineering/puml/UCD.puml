@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
'skinparam shadowing false


'title Use Case Diagram Example

left to right direction

'rectangle "System Actors" as actors {
    actor "Player" as Player
    actor "Editor" as Editor
    actor "Product\nOwner" as Owner
'}

'rectangle "Use Cases" as usecases{
    usecase "UC1 - Create a map" as UC1
    Editor --> UC1

    usecase "UC2 - Add an industry" as UC2
    Editor --> UC2

    usecase "UC3 - Add a city" as UC3
    Editor --> UC3

    usecase "UC4 - Create a scenario" as UC4
    Editor --> UC4

    usecase "UC5 - Build a station." as UC5
    Player --> UC5

    usecase "UC6 - Upgrade a selected station with a building" as UC6
    Player --> UC6

    usecase "UC7 -  See the details of a station" as UC7
    Player --> UC7

    usecase "UC8 -  Build railway line" as UC8
    Player --> UC8

    usecase "UC9 -  Buy a train" as UC9
    Player --> UC9

    usecase "UC10 - Assign a train to a route" as UC10
    Player --> UC10

    usecase "UC11 - List all trains" as UC11
    Player --> UC11

    usecase "UC12 - Run a simulator" as UC12
    "Player" --> UC12

    usecase "UC13 - Verify a train path" as UC13
    "Player" --> UC13

    usecase "UC14 - Plan maintenance route" as UC14
    "Player" --> UC14

    usecase "UC15 - Analyse station profit" as UC15
    "Player" --> UC15

    usecase "UC16 - Compare passenger arrivals" as UC16
    "Player" --> UC16

    usecase "UC17 - Analyse cargo distribution" as UC17
    "Player" --> UC17

    usecase "UC18 - Visualize train/passenger/mail distribuction" as UC18
    "Player" --> UC18

'}


@enduml