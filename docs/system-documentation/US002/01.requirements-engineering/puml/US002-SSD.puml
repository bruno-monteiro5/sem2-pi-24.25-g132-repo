@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":System" as System

activate Employee

    Employee -> System : select a map
    activate System

        System --> Employee : show the selected map
    deactivate System

    Employee -> System : choose the position XY for the new industry
    activate System

        System --> Employee : requests data (i.e. type, name, cost,)
    deactivate System

    Employee -> System : insert the industry details
    activate System

        System --> Employee : shows all data and requests confirmation
    deactivate System

    Employee -> System : confirms data
    activate System

        System --> Employee : displays operation success
    deactivate System
@enduml