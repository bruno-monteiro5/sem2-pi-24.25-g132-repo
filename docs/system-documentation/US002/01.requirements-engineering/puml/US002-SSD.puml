@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":System" as System

activate Editor

    Editor -> System : asks to add an industry
    activate System

        System --> Editor : shows industry types list
    deactivate System

    Editor -> System : selects an industry type
    activate System

        System --> Editor : shows industries of selected type
    deactivate System

    Editor -> System : selects an industry
    activate System

        System --> Editor : asks for coordinates (X and Y)
    deactivate System

    Editor -> System : types coordinates
    activate System

        System --> Editor : displays industry data
        System --> Editor : asks for confirmation (Y-yes/N-no)
    deactivate System

    Editor -> System : confirms creation (Y/N)
    activate System

    alt User confirms (Y)
        System --> Editor : adds industry and displays operation success
    else User cancels (N)
        System --> Editor : displays cancellation message
    end

    deactivate System
@enduml
