@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":System" as System

activate Editor

    Editor -> System : asks to add an industry
    activate System

        System --> Editor : shows industry types list
        System --> Editor : asks to select a type
    deactivate System

    Editor -> System : selects an industry type
    activate System

        System --> Editor : shows industries of selected type
        System --> Editor : asks to select an industry
    deactivate System

    Editor -> System : selects an industry
    activate System

        System --> Editor : asks for X coordinate
    deactivate System

    Editor -> System : inputs X
    activate System
        System --> Editor : validates X
        System --> Editor : asks for Y coordinate
    deactivate System

    Editor -> System : inputs Y
    activate System
        System --> Editor : validates Y
        System --> Editor : displays industry name, type, and position
        System --> Editor : asks for confirmation (Y-yes/N-no)
    deactivate System

    Editor -> System : confirms (Y) or cancels (N)
    activate System

    alt User confirms (Y)
        System --> Editor : adds industry and displays operation success
    else User cancels (N)
        System --> Editor : displays cancellation message
    end

    deactivate System
@enduml
