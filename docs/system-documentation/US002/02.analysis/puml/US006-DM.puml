@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Map {
    name
    size
}

class Industry {
    positionX
    positionY
}

class PrimaryIndustry {
    resource
    farms
}

class TransformingIndustry {
    initialResource
    finalResource
}

class MixedIndustry {
    importedResource
    exportedResource
}

class Editor {
    username
    password

}


Editor "1" - "*" Industry: adds

Map "1" - "*" Industry : has
Industry <|-- PrimaryIndustry
Industry <|-- TransformingIndustry
Industry <|-- MixedIndustry


@enduml