<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.UpgradeStationFXController"
            prefWidth="600.0" prefHeight="400.0"
            style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);">

    <top>
        <Label text="🚀 Upgrade Station"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #003b49; -fx-padding: 20 0 10 0;"
               maxWidth="Infinity"
               alignment="CENTER" />
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25" />
            </padding>
            <children>
                <HBox spacing="10" alignment="CENTER">
                    <Label text="Station:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="stationComboBox" prefWidth="250"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Available Upgrades:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="upgradeComboBox" prefWidth="250"/>
                </HBox>

                <Label fx:id="feedbackLabel" text=""
                       style="-fx-text-fill: red; -fx-font-style: italic;" />

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="confirmButton"
                            text="Apply Upgrade"
                            onAction="#handleUpgrade"
                            style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="150"/>

                    <Button text="Back to Menu"
                            onAction="#handleBack"
                            style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;" />
                </HBox>
            </children>
        </VBox>
    </center>

</BorderPane>
