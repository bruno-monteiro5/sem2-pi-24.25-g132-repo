<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.AddIndustryFXController"
            prefWidth="600.0" prefHeight="400.0"
            style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);">

    <top>
        <Label text="🏭 Add Industry"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #003b49; -fx-padding: 20 0 10 0;"
               maxWidth="Infinity"
               alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>
            <children>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Industry Type:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="industryComboBox" prefWidth="250"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="X:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="xField" promptText="X" prefWidth="80"/>
                    <Label text="Y:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="yField" promptText="Y" prefWidth="80"/>
                </HBox>

                <Label fx:id="feedbackLabel" text=""
                       style="-fx-text-fill: red;"/>

                <HBox spacing="15" alignment="CENTER">
                    <Button text="Add Industry"
                            onAction="#handleAddIndustry"
                            style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="150"/>

                    <Button text="Back to Menu"
                            onAction="#handleBack"
                            style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;" />
                </HBox>

            </children>
        </VBox>
    </center>
</BorderPane>

