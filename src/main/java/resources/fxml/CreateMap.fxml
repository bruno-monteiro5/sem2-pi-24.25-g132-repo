<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.CreateMapFXController"
            prefWidth="600.0" prefHeight="400.0"
            style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);">

    <top>
        <Label text="🗺 Create Map"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #003b49; -fx-padding: 20 0 10 0;"
               maxWidth="Infinity"
               alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>
            <children>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Map Name:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="mapNameField" promptText="Enter map name..." prefWidth="200"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Width:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="widthField" prefWidth="80"/>
                    <Label text="Height:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="heightField" prefWidth="80"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Scale:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="scaleField" prefWidth="80"/>
                </HBox>

                <Label fx:id="feedbackLabel" text=""
                       style="-fx-text-fill: red;"/>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="createButton"
                            text="Create Map"
                            onAction="#handleCreateMap"
                            style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="150"/>

                    <Button text="Back to Menu"
                            onAction="#handleBack"
                            style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;" />
                </HBox>

            </children>
        </VBox>
    </center>
</BorderPane>