<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="980.0"
            style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.BuildStationFXController">

    <center>
        <VBox alignment="CENTER" spacing="15" maxWidth="420" prefWidth="420">
            <padding>
                <Insets bottom="25" left="25" right="25" top="25" />
            </padding>
            <children>
                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #003b49;" text="🚆 Build New Station" />

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Station Type:" />
                        <ComboBox fx:id="typeComboBox" prefWidth="250" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Name:" />
                        <TextField fx:id="nameField" prefWidth="250" promptText="Optional" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Coordinates:" />
                        <TextField prefWidth="80" promptText="X" fx:id="xField" />
                        <TextField fx:id="yField" prefWidth="80" promptText="Y" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Direction:" />
                        <ComboBox fx:id="directionComboBox" prefWidth="250" />
                    </children>
                </HBox>

                <Label fx:id="messageLabel" style="-fx-text-fill: red; -fx-font-style: italic; -fx-padding: 10 0 0 0;" text="" wrapText="true" />

                <HBox alignment="CENTER" spacing="20">
                    <children>
                        <Button onAction="#handleCreateStation" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="Create Station" />
                        <Button onAction="#handleBack" style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;" text="Back" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

</BorderPane>