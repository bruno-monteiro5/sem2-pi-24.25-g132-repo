<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.CreateCityFXController"
            prefWidth="600.0" prefHeight="500.0"
            style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);">

    <top>
        <Label text="🌆 Create City"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #003b49; -fx-padding: 20 0 10 0;"
               maxWidth="Infinity"
               alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>
            <children>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="City Name:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="nameField" promptText="Enter city name..." prefWidth="200"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="X Position:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="xField" prefWidth="80"/>
                    <Label text="Y Position:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="yField" prefWidth="80"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="House Blocks:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="houseBlocksField" prefWidth="80"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Assign Mode:" style="-fx-font-weight: bold;"/>
                    <RadioButton fx:id="autoRadio" text="Automatic" selected="true"/>
                    <RadioButton fx:id="manualRadio" text="Manual"/>
                </HBox>

                <VBox spacing="5" alignment="CENTER">
                    <Label text="Manual Block Positions (format: x1,y1;x2,y2;...)" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="manualTextArea" prefWidth="300" prefRowCount="3" promptText="e.g. 10,10;11,11"/>
                </VBox>

                <Label fx:id="feedbackLabel" text="" style="-fx-text-fill: red;"/>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="createButton"
                            text="Create City"
                            onAction="#handleCreateCity"
                            style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="150"/>

                    <Button text="Back to Menu"
                            onAction="#handleBack"
                            style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;" />
                </HBox>

            </children>
        </VBox>
    </center>
</BorderPane>
