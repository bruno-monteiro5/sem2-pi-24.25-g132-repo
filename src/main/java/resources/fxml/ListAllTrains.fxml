<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.ListAllTrainsFXController"
            prefWidth="700.0" prefHeight="500.0"
            style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);">

    <top>
        <Label text="🚆 List All Trains"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #003b49; -fx-padding: 20 0 10 0;"
               maxWidth="Infinity"
               alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <TextArea fx:id="trainListArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="350"
                      prefWidth="600"
                      style="-fx-control-inner-background: #f4f9ff; -fx-border-color: #b0bec5;" />

            <Button text="Back to Menu"
                    onAction="#handleBack"
                    style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;" />
        </VBox>
    </center>
</BorderPane>
