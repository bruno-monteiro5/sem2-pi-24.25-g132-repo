<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.AssignTrainToRouteFXController"
            prefWidth="700.0" prefHeight="500.0"
            style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);">

    <top>
        <Label text="🚆 Assign Train to Route"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #003b49; -fx-padding: 20 0 10 0;"
               maxWidth="Infinity"
               alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>
            <children>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Train:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="trainComboBox" prefWidth="300"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Route Name:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="routeNameField" prefWidth="300"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Station:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="stationComboBox" prefWidth="300"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Cargo Types:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="cargoField" promptText="Comma-separated" prefWidth="300"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Cargo Mode:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="modeComboBox" prefWidth="300"/>
                </HBox>

                <Label fx:id="statusLabel"
                       text=""
                       style="-fx-text-fill: red; -fx-font-style: italic;" />

                <HBox spacing="15" alignment="CENTER">
                    <Button text="Add Point to Route"
                            onAction="#handleAddPoint"
                            style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="180"/>

                    <Button text="Assign Route to Train"
                            onAction="#handleAssignRoute"
                            style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="180"/>
                </HBox>

                <Button text="Back to Menu"
                        onAction="#handleBack"
                        style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;"
                        prefWidth="180"/>

            </children>
        </VBox>
    </center>
</BorderPane>
