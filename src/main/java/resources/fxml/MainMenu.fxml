<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="980.0" style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.MainMenuController">

    <top>
        <VBox spacing="10" style="-fx-padding: 10;">
            <HBox spacing="20">
                <Label fx:id="mapLabel" text="Map: -" />
                <Label fx:id="scenarioLabel" text="Scenario: -" />
                <Label fx:id="yearLabel" text="Year: -" />
                <Label fx:id="budgetLabel" text="Budget: -" />
                <Label fx:id="scaleLabel" text="Scale: -" />
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="startButton" text="▶ Start"

                        style="-fx-background-color: #43a047; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 18;" />
                <Button fx:id="pauseButton" text="⏸ Pause"

                        style="-fx-background-color: #ef6c00; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 18;" />
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox prefWidth="200" style="-fx-padding: 10;">
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="5">
                <Label text="Events"/>
                <ListView fx:id="eventListView"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" fitToHeight="true" pannable="true">
                <StackPane fx:id="mapArea" prefWidth="700" prefHeight="650">
                    <ImageView fx:id="mapImageView"
                               fitWidth="650.0"
                               fitHeight="640.0"
                               preserveRatio="true">
                        <image>
                            <Image url="@/images/map.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </ScrollPane>
            <Label fx:id="noMapLabel"
                   text="No map loaded. Please return to login."
                   visible="false"
                   style="-fx-font-size: 18px; -fx-text-fill: darkred;" />
        </StackPane>
    </center>

    <right>
        <VBox prefWidth="200" style="-fx-padding: 10;">
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="10" alignment="CENTER">
                <Button text="Build Station" onAction="#handleBuildStation"
                        onMouseEntered="#highlight" onMouseExited="#resetHighlight"
                        style="-fx-background-color: #00695c; -fx-text-fill: white;" />
                <Button text="Upgrade Station" onAction="#handleUpgradeStation"
                        onMouseEntered="#highlight" onMouseExited="#resetHighlight"
                        style="-fx-background-color: #00695c; -fx-text-fill: white;" />
                <Button text="See Station Details" onAction="#handleStationDetails"
                        onMouseEntered="#highlight" onMouseExited="#resetHighlight"
                        style="-fx-background-color: #00695c; -fx-text-fill: white;" />
                <Button text="Build a Railway Line" onAction="#handleBuildRailwayLine"
                        onMouseEntered="#highlight" onMouseExited="#resetHighlight"
                        style="-fx-background-color: #00695c; -fx-text-fill: white;" />
                <Button text="Buy a Locomotive" onAction="#handleBuyLocomotive"
                        onMouseEntered="#highlight" onMouseExited="#resetHighlight"
                        style="-fx-background-color: #00695c; -fx-text-fill: white;" />
                <Button text="Create a Train" onAction="#handleCreateTrain"
                        onMouseEntered="#highlight" onMouseExited="#resetHighlight"
                        style="-fx-background-color: #00695c; -fx-text-fill: white;" />
                <Button text="Assign Train to Route" onAction="#handleAssignTrainToARoute"
                        onMouseEntered="#highlight" onMouseExited="#resetHighlight"
                        style="-fx-background-color: #00695c; -fx-text-fill: white;" />
                <Button text="List all trains" onAction="#handleListAllTrains"
                        onMouseEntered="#highlight" onMouseExited="#resetHighlight"
                        style="-fx-background-color: #00695c; -fx-text-fill: white;" />
                <Button fx:id="backToLoginButton" text="Back to Login"
                        onAction="#handleLogout"
                        onMouseEntered="#highlight"
                        onMouseExited="#resetHighlight"
                        style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;" />

            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>


    <bottom>
        <HBox alignment="BOTTOM_RIGHT" spacing="10" style="-fx-padding: 10;">
            <Label text="Zoom"/>
            <Slider fx:id="zoomSlider" min="0.5" max="2.0" value="1.0" blockIncrement="0.1" prefWidth="150"/>
        </HBox>
    </bottom>

</BorderPane>
