<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="980.0" style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.MainMenuController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label fx:id="mapLabel" text="Map: -" />
                <Label fx:id="scenarioLabel" text="Scenario: -" />
                <Label fx:id="yearLabel" text="Year: -" />
                <Label fx:id="budgetLabel" text="Budget: -" />
                <Label fx:id="scaleLabel" text="Scale: -" />
            </children>
        </HBox>
    </top>

    <center>
        <Pane fx:id="mapArea">
            <children>
                <ImageView fx:id="mapImageView" fitHeight="640.0" fitWidth="650.0" preserveRatio="true">
                    <image>
                        <Image url="@/images/map.png" />
                    </image>
                </ImageView>
            </children>
        </Pane>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefHeight="700.0" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="40.0" />
            </padding>
            <children>
                <Button onAction="#handleBuildStation" prefHeight="31.0" prefWidth="187.0" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="Build Station" />
                <Button onAction="#handleUpgradeStation" prefHeight="31.0" prefWidth="187.0" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="Upgrade Station" />
                <Button onAction="#handleStationDetails" prefHeight="31.0" prefWidth="187.0" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="See Station Details" />
                <Button onAction="#handleBuildRailwayLine" prefHeight="31.0" prefWidth="187.0" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="Build a Railway Line" />
                <Button onAction="#handleBuyLocomotive" prefHeight="31.0" prefWidth="187.0" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="Buy a Locomotive" />
                <Button onAction="#handleCreateTrain" prefHeight="31.0" prefWidth="187.0" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="Create a Train" />
                <Button onAction="#handleAssignTrainToARoute" prefHeight="31.0" prefWidth="187.0" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="Assign Train to Route" />
                <Button onAction="#handleListAllTrains" prefHeight="31.0" prefWidth="187.0" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="List all trains" />
                <Button onAction="#handleStartSimulation" prefHeight="31.0" prefWidth="187.0" style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;" text="Run Simulation" />
                <Button onAction="#handleLogout"  style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;" text="Back to Login" />
            </children>
        </VBox>
    </right>

</BorderPane>
