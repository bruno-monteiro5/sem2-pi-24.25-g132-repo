<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pt.ipp.isep.dei.ui.MainMenuController"
            prefHeight="400.0" prefWidth="600.0">

    <VBox alignment="CENTER" spacing="15" layoutX="200" layoutY="100">
        <Button text="Criar Estação" onAction="#handleBuildStation"/>
        <Button text="Fazer Upgrade" onAction="#handleUpgradeStation"/>
        <Button text="Ver Detalhes da Estação" onAction="#handleStationDetails"/>
        <Button text="Iniciar Simulação" onAction="#handleStartSimulation"/>
    </VBox>

</AnchorPane>

