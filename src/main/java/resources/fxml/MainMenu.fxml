<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.effect.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>


<VBox prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.MainMenuController">
   <children>
   
       <StackPane prefHeight="300.0" prefWidth="400.0">
      <children>
            <ImageView fitHeight="300.0" fitWidth="400.0">
               <effect>
                  <Glow />
               </effect>
               <image>
                  <Image url="@/images/wallpaper.png" />
               </image>
              </ImageView>
      
              <VBox alignment="CENTER" spacing="15">
         <children>
                     <Button onAction="#handleBuildStation" text="Build Station" />
                     <Button onAction="#handleUpgradeStation" text="Upgrade Station" />
                     <Button onAction="#handleStationDetails" text="See Station Details" />
                     <Button onAction="#handleStartSimulation" text="Run Simulation" />
         </children>
              </VBox>
      </children>
   
       </StackPane>
   </children>

</VBox>
