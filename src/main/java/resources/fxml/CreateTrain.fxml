<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.CreateTrainFXController"
            prefWidth="600.0" prefHeight="400.0"
            style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);">

    <top>
        <Label text="🚂 Create Train"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #003b49; -fx-padding: 20 0 10 0;"
               maxWidth="Infinity"
               alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <HBox spacing="10" alignment="CENTER">
                <Label text="Locomotive:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="locomotiveComboBox" prefWidth="300"/>
            </HBox>

            <Label fx:id="statusLabel"
                   text=""
                   style="-fx-text-fill: red; -fx-font-style: italic;" />

            <HBox spacing="15" alignment="CENTER">
                <Button text="Create Train"
                        onAction="#onCreateTrain"
                        style="-fx-background-color: #00695c; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="180"/>

                <Button text="Back to Menu"
                        onAction="#handleBack"
                        style="-fx-background-color: #b0bec5; -fx-text-fill: #263238; -fx-font-weight: bold;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
