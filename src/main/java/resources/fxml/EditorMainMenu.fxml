<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-image: url('/images/editor_background.png');                    -fx-background-size: cover;                    -fx-background-repeat: no-repeat;                    -fx-background-position: center;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.controller.EditorMainMenuController">

    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">
            <children>
                <Button onAction="#handleCreateMap" prefWidth="200" text="Create Map" />
                <Button onAction="#handleAddIndustry" prefWidth="200" text="Add Industry" />
                <Button onAction="#handleCreateCity" prefWidth="200" text="Create City" />
                <Button onAction="#handleCreateScenario" prefWidth="200" text="Create Scenario" />
                <Button onAction="#handleBack" prefWidth="200" style="-fx-background-color: #b0bec5; -fx-text-fill: #263238;" text="Back to Login" />
            </children>
        </VBox>
    </center>
</BorderPane>
