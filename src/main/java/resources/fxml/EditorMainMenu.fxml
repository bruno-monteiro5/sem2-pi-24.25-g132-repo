<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.EditorMainMenuController"
            prefWidth="800.0" prefHeight="600.0">

    <top>
        <Label text="Editor Menu"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15">
            <Button text="Create Map" onAction="#handleCreateMap"/>
            <Button text="Create Scenario" onAction="#handleCreateScenario"/>
            <Button text="Add City" onAction="#handleAddCity"/>
            <Button text="Add Industry" onAction="#handleAddIndustry"/>
            <Button text="Back to Login" onAction="#handleBack"/>
        </VBox>
    </center>
</BorderPane>
