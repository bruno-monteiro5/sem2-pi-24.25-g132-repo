<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.ipp.isep.dei.controller.EditorMainMenuController"
            prefWidth="800.0" prefHeight="600.0"
            style="-fx-background-color: linear-gradient(to bottom, #f0f8ff, #d9ecf2);">

    <top>
        <Label text="🖊 EDITOR MENU"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20 0 10 0;"
               maxWidth="Infinity"
               alignment="CENTER"/>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">
            <children>
                <Button onAction="#handleCreateMap" text="Create Map" prefWidth="200"/>
                <Button onAction="#handleCreateScenario" text="Create Scenario" prefWidth="200"/>
                <Button onAction="#handleAddCity" text="Add City" prefWidth="200"/>
                <Button onAction="#handleAddIndustry" text="Add Industry" prefWidth="200"/>
                <Button onAction="#handleBack" text="Back to Login" prefWidth="200"
                        style="-fx-background-color: #b0bec5; -fx-text-fill: #263238;"/>
            </children>
        </VBox>
    </center>
</BorderPane>